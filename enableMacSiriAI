normalized_locale() {
    printf '%s' "$1" | /usr/bin/sed 's/_/-/'
}

system_proxy_url() {
    local settings enabled host port
    [ "$TEST_MODE" != "1" ] || return 1
    settings="$(/usr/sbin/scutil --proxy 2>/dev/null)" || return 1
    enabled="$(printf '%s\n' "$settings" | /usr/bin/awk '/HTTPS?Enable :/ { if ($3 == 1) { print $3; exit } }')"
    [ "$enabled" = "1" ] || return 1
    host="$(printf '%s\n' "$settings" | /usr/bin/awk '/HTTPS?Proxy :/ { print $3; exit }')"
    port="$(printf '%s\n' "$settings" | /usr/bin/awk '/HTTPS?Port :/ { print $3; exit }')"
    [ -n "$host" ] && [ -n "$port" ] || return 1
    printf 'http://%s:%s\n' "$host" "$port"
}

public_dns_ip_for_domain() {
    local domain="$1" json result
    json="$(/usr/bin/curl --silent --show-error --fail --get --max-time 8 \
        --data-urlencode "name=$domain" --data 'type=A' 'https://dns.google/resolve' 2>/dev/null)" || return 1
    result="$(printf '%s' "$json" | /usr/bin/plutil -convert xml1 -o - - 2>/dev/null | /usr/bin/awk '
        /<key>data<\/key>/ { want_data=1; next }
        want_data && /<string>/ {
            data=$0
            sub(/^.*<string>/, "", data)
            sub(/<\/string>.*$/, "", data)
            want_data=0
            next
        }
        /<key>type<\/key>/ { want_type=1; next }
        want_type && /<integer>1<\/integer>/ { if (data ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) { print data; exit }; want_type=0; next }
        want_type && /<integer>/ { want_type=0; next }
        /<\/dict>/ { data=""; want_data=0; want_type=0 }
    ')"
    [ -n "$result" ] || return 1
    printf '%s\n' "$result"
}

connected_ip_for_domain() {
    local domain="$1" proxy rc ip
    if [ "$TEST_MODE" = "1" ]; then
        if [ -n "${ENABLE_MAC_SIRI_AI_TEST_ROUTE_RESULTS:-}" ]; then
            /usr/bin/awk -v wanted="$domain" '$1==wanted { print $2; exit }' "$ENABLE_MAC_SIRI_AI_TEST_ROUTE_RESULTS"
        fi
        return 0
    fi
    proxy="$(system_proxy_url 2>/dev/null || true)"
    if [ -n "$proxy" ]; then
        /usr/bin/curl --insecure --silent --show-error --output /dev/null \
            --connect-timeout 4 --max-time 8 --proxy "$proxy" "https://${domain}/" 2>/dev/null
        rc=$?
    else
        /usr/bin/curl --insecure --silent --show-error --output /dev/null \
            --connect-timeout 4 --max-time 8 "https://${domain}/" 2>/dev/null
        rc=$?
    fi
    [ "$rc" -eq 0 ] || return 1
    ip="$(/usr/bin/dscacheutil -q host -a name "$domain" 2>/dev/null | /usr/bin/awk '/ip_address:/ { print $2; exit }')"
    if [ -z "$ip" ] && command -v /usr/bin/dig >/dev/null 2>&1; then
        ip="$(/usr/bin/dig +short A "$domain" 2>/dev/null | /usr/bin/awk 'NF { print; exit }')"
    fi
    if [ -n "$ip" ] && is_fake_or_local_ip "$ip"; then
        ip="$(public_dns_ip_for_domain "$domain" 2>/dev/null || printf '%s' "$ip")"
    fi
    printf '%s\n' "$ip"
}

country_for_ip() {
    local ip="$1" json
    if [ "$TEST_MODE" = "1" ] && [ -n "${ENABLE_MAC_SIRI_AI_TEST_ROUTE_RESULTS:-}" ]; then
        /usr/bin/awk -v wanted="$ip" '$2==wanted { print $3; exit }' "$ENABLE_MAC_SIRI_AI_TEST_ROUTE_RESULTS"
        return 0
    fi
    json="$(/usr/bin/curl --silent --show-error --fail --get --max-time 8 \
        --data-urlencode "ip=$ip" 'https://api.iplocation.net/' 2>/dev/null)" || return 1
    printf '%s' "$json" | /usr/bin/plutil -extract country_code2 raw - 2>/dev/null
}

is_fake_or_local_ip() {
    case "$1" in
        10.*|127.*|169.254.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*|192.168.*|198.18.*|198.19.*|::1|fc*|fd*|fe80:*) return 0 ;;
        *) return 1 ;;
    esac
}

audit_siri_routes() {
    local domain ip country proxy proxy_label
    SIRI_ROUTE_LEAK_COUNT=0
    SIRI_ROUTE_UNKNOWN_COUNT=0
    printf '\nSiri AI network endpoints / Siri AI 联网端点:\n'
    proxy="$(system_proxy_url 2>/dev/null || true)"
    if [ -n "$proxy" ]; then proxy_label="$proxy"; else proxy_label="none or TUN / 未检测到或使用 TUN"; fi
    printf '  System proxy / 系统代理: %s\n' "$proxy_label"
    while IFS= read -r domain; do
        [ -n "$domain" ] || continue
        ip="$(connected_ip_for_domain "$domain")"
        if [ -z "$ip" ]; then
            SIRI_ROUTE_UNKNOWN_COUNT=$((SIRI_ROUTE_UNKNOWN_COUNT + 1))
            continue
        fi
        if is_fake_or_local_ip "$ip"; then
            SIRI_ROUTE_UNKNOWN_COUNT=$((SIRI_ROUTE_UNKNOWN_COUNT + 1))
            continue
        fi
        country="$(country_for_ip "$ip" 2>/dev/null)" || country=""
        case "$country" in
            CN)
                SIRI_ROUTE_LEAK_COUNT=$((SIRI_ROUTE_LEAK_COUNT + 1))
                ;;
            "")
                SIRI_ROUTE_UNKNOWN_COUNT=$((SIRI_ROUTE_UNKNOWN_COUNT + 1))
                ;;
            *) ;;
        esac
    done <<EOF
$SIRI_ROUTE_DOMAINS
EOF

    if [ "$SIRI_ROUTE_LEAK_COUNT" -gt 0 ] || [ "$SIRI_ROUTE_UNKNOWN_COUNT" -gt 0 ]; then
        warn "Siri AI may not be able to access the network normally. / Siri AI 可能无法正常联网。"
        info "If access fails, use the latest routing module below, or enable global proxy and TUN mode. / 如果无法正常访问，可使用下方最新版分流模块，或将代理切换为全局并开启 TUN 模式。"
        info "For Clash, set the TUN stack to system. / 如果使用 Clash，请将 TUN 模式堆栈改为 system。"
        info "Loon: $LOON_MODULE_URL"
        info "Shadowrocket: $SHADOWROCKET_MODULE_URL"
    else
        ok "No Siri AI domain connected to a China endpoint. / 未发现连接到中国端点的 Siri AI 域名。"
    fi
}

print_greymatter_input() {
    local key="$1" value
    value="$(eligibility_domain_value OS_ELIGIBILITY_DOMAIN_GREYMATTER "status:$key")"
    printf '  %-38s %s\n' "${key#OS_ELIGIBILITY_INPUT_}" "$value"
}

command_diagnose() {
    local answer foundation app_intents locale siri_locale locale_match region_match enabled available chatgpt
    local system_country siri_country
    local codes code_count country_ready

    printf '%s %s - Siri AI diagnosis / Siri AI 诊断（只读）\n' "$PROGRAM" "$VERSION"
    printf '  macOS:                  %s\n' "$(os_version)"
    printf '  Architecture / 架构:   %s\n' "$(machine_arch)"
    printf '  Device region / 设备区域: %s\n' "$(device_region 2>/dev/null || printf '%s' 'unavailable / 无法读取')"

    codes=""
    if [ -f "$TARGET" ] && validate_archive "$TARGET"; then
        codes="$(all_country_codes "$TARGET" 2>/dev/null | /usr/bin/awk '!seen[$0]++' | /usr/bin/paste -sd, -)"
    fi
    printf '  CountryCode references: %s\n' "${codes:-unavailable / 无法读取}"

    printf '\nEligibility / 资格:\n'
    answer="$(eligibility_domain_value OS_ELIGIBILITY_DOMAIN_GREYMATTER os_eligibility_answer_t)"
    foundation="$(eligibility_domain_value OS_ELIGIBILITY_DOMAIN_FOUNDATION_MODELS os_eligibility_answer_t)"
    app_intents="$(eligibility_domain_value OS_ELIGIBILITY_DOMAIN_SIRI_WITH_APP_INTENTS os_eligibility_answer_t)"
    printf '  GREYMATTER answer:                    %s\n' "$answer"
    printf '  FOUNDATION_MODELS answer:             %s\n' "$foundation"
    printf '  SIRI_WITH_APP_INTENTS answer:         %s\n' "$app_intents"
    print_greymatter_input OS_ELIGIBILITY_INPUT_COUNTRY_BILLING
    print_greymatter_input OS_ELIGIBILITY_INPUT_COUNTRY_LOCATION
    print_greymatter_input OS_ELIGIBILITY_INPUT_DEVICE_AND_SIRI_LANGUAGE_MATCH
    print_greymatter_input OS_ELIGIBILITY_INPUT_DEVICE_CLASS
    print_greymatter_input OS_ELIGIBILITY_INPUT_DEVICE_LANGUAGE
    print_greymatter_input OS_ELIGIBILITY_INPUT_DEVICE_REGION_CODE
    print_greymatter_input OS_ELIGIBILITY_INPUT_EXTERNAL_BOOT_DRIVE
    print_greymatter_input OS_ELIGIBILITY_INPUT_GENERATIVE_MODEL_SYSTEM
    print_greymatter_input OS_ELIGIBILITY_INPUT_SHARED_IPAD
    print_greymatter_input OS_ELIGIBILITY_INPUT_SIRI_LANGUAGE

    locale="$(system_locale)"
    siri_locale="$(siri_language)"
    if [ "$(normalized_locale "$locale")" = "$(normalized_locale "$siri_locale")" ]; then
        locale_match="yes / 是"
    else
        locale_match="no / 否"
    fi
    system_country="$(normalized_locale "$locale" | /usr/bin/awk -F- '{ value=$NF; sub(/@.*/, "", value); print value }')"
    siri_country="$(normalized_locale "$siri_locale" | /usr/bin/awk -F- '{ print $NF }')"
    if [ -n "$codes" ] && [ "$codes" = "$system_country" ] && [ "$codes" = "$siri_country" ]; then
        region_match="yes / 是"
    else
        region_match="no / 否"
    fi
    enabled="$(siri_enabled)"
    available="$(siri_available)"
    chatgpt="$(chatgpt_enabled)"
    printf '\nSiri and language / Siri 与语言:\n'
    printf '  System locale / 系统区域:             %s\n' "$locale"
    printf '  Siri language / Siri 语言:            %s\n' "$siri_locale"
    printf '  Language match / 语言匹配:            %s\n' "$locale_match"
    printf '  CountryCode/locale match / 地区匹配:  %s\n' "$region_match"
    printf '  Siri enabled / Siri 已开启:           %s\n' "$enabled"
    printf '  Siri available / Siri 可用:           %s\n' "$available"
    printf '  ChatGPT extension / ChatGPT 扩展:     %s\n' "$chatgpt"

    audit_siri_routes

    country_ready=0
    code_count="$(printf '%s' "$codes" | /usr/bin/awk -F, 'NF { print NF }')"
    if [ "${code_count:-0}" = "1" ] && is_allowed_country "$codes" &&
       [ "$answer" = "4" ] &&
       [ "$(eligibility_domain_value OS_ELIGIBILITY_DOMAIN_GREYMATTER 'status:OS_ELIGIBILITY_INPUT_COUNTRY_LOCATION')" = "3" ]; then
        country_ready=1
    fi

    printf '\nConclusion / 结论:\n'
    if [ "$country_ready" -eq 1 ]; then
        ok "Country-code setup is complete. / 国家码设置已经完成。"
        if [ "$SIRI_ROUTE_LEAK_COUNT" -gt 0 ] || [ "$SIRI_ROUTE_UNKNOWN_COUNT" -gt 0 ]; then
            info "Follow the network suggestions above if Siri AI is unavailable. / 如果 Siri AI 仍不可用，请按上方联网建议处理。"
        else
            info "Any remaining problem is outside the country-code setup; check proxy routing, Apple server eligibility, and macOS beta availability. / 剩余问题不属于国家码修改范围，请检查代理分流、Apple 服务端资格和 macOS 测试版功能开放情况。"
        fi
    else
        warn "Country-code or eligibility checks are incomplete. / 国家码或资格检查尚未全部通过。"
    fi
}

command_status() {
    local version arch sip region flags owner mode backup codes answer location
    version="$(os_version)"; arch="$(machine_arch)"; sip="$(sip_status)"
    region="$(device_region 2>/dev/null)" || region="unavailable / 无法读取"
    printf '%s %s\n' "$PROGRAM" "$VERSION"
    printf '  macOS:                  %s\n' "$version"
    printf '  Architecture / 架构:   %s\n' "$arch"
    printf '  SIP:                    %s\n' "$sip"
    printf '  Device region / 设备区域: %s\n' "$region"
    printf '  Cache / 缓存:           %s\n' "$TARGET"

    if [ ! -f "$TARGET" ]; then
        printf '  Cache state / 缓存状态: missing / 不存在\n'
    elif ! validate_archive "$TARGET"; then
        printf '  Cache state / 缓存状态: unsupported or damaged / 不受支持或已损坏\n'
    else
        owner="$(/usr/bin/stat -f '%Su:%Sg' "$TARGET" 2>/dev/null || printf '%s' '—')"
        mode="$(/usr/bin/stat -f '%Sp (%Lp)' "$TARGET" 2>/dev/null || printf '%s' '—')"
        flags="$(file_flags "$TARGET" 2>/dev/null || printf '%s' '—')"
        printf '  Owner / 所有者:         %s\n' "$owner"
        printf '  Mode / 权限:            %s\n' "$mode"
        printf '  Flags / 标志:           %s\n' "$flags"
        if has_uchg "$TARGET"; then printf '  Lock / 锁定:            uchg (locked / 已锁定)\n'; else printf '  Lock / 锁定:            unlocked / 未锁定\n'; fi
        printf '\nCountry sources / 国家码来源:\n'
        print_source_status "Location / 定位" "LocalCountryEstimatesLocation"
        print_source_status "GeoIP" "LocalCountryEstimatesGeoIP"
        print_source_status "Wi-Fi" "LocalCountryEstimatesWiFiAPs"
        print_source_status "Combined / 综合" "CombinedEstimate"
        print_source_status "Last combined / 上次综合" "LastKnownCombinedEstimate"
        codes="$(all_country_codes "$TARGET" 2>/dev/null | /usr/bin/awk '!seen[$0]++' | /usr/bin/paste -sd, -)"
        printf '  %-24s %s\n' "All referenced / 全部引用" "${codes:-—}"
    fi

    if [ -d "$STATE_DIR" ]; then backup="present / 已保存"; else backup="absent / 未保存"; fi
    printf '  Original backup / 原始备份: %s\n' "$backup"

    if [ "$TEST_MODE" != "1" ] && [ -f "$ELIGIBILITY_PLIST" ]; then
        answer="$(eligibility_value os_eligibility_answer_t)"
        location="$(eligibility_value 'status:OS_ELIGIBILITY_INPUT_COUNTRY_LOCATION')"
        printf '\nEligibility diagnostics / 资格诊断（只读）:\n'
        printf '  GREYMATTER answer:      %s\n' "$answer"
        printf '  COUNTRY_LOCATION input: %s\n' "$location"
    fi
}

interactive_menu() {
    local choice country
    while :; do
        printf '\n'
        command_status
        cat <<'EOF'

Actions / 操作:
  1) Set US / 设置 US
  2) Set CA / 设置 CA
  3) Set another preset / 设置其他预设（GB AU JP SG）
  4) Unlock only / 仅解锁
  5) Restore original / 恢复原始缓存
  6) Refresh status / 刷新状态
  7) Diagnose Siri AI / 诊断 Siri AI（只读）
  0) Exit / 退出
EOF
        printf '> '
        IFS= read -r choice || return 0
        case "$choice" in
            1) "$SELF" set US || warn "Set failed / 设置失败" ;;
            2) "$SELF" set CA || warn "Set failed / 设置失败" ;;
            3)
                printf 'GB / AU / JP / SG > '
                IFS= read -r country || return 0
                is_allowed_country "$country" || { warn "Invalid preset / 预设无效"; continue; }
                case "$country" in US|CA) warn "Use menu item 1 or 2. / 请使用菜单 1 或 2。"; continue ;; esac
                "$SELF" set "$country" || warn "Set failed / 设置失败"
                ;;
            4) "$SELF" unlock || warn "Unlock failed / 解锁失败" ;;
            5)
                printf 'Type RESTORE or restore to confirm / 输入 RESTORE 或 restore 确认: '
                IFS= read -r country || return 0
                case "$country" in
                    [Rr][Ee][Ss][Tt][Oo][Rr][Ee]) ;;
                    *) info "Cancelled / 已取消"; continue ;;
                esac
                printf 'Delete the backup after a successful restore? [y/N] / 恢复成功后删除备份？[y/N]: '
                IFS= read -r choice || return 0
                case "$choice" in
                    [Yy]|[Yy][Ee][Ss]) "$SELF" restore --delete-backup || warn "Restore failed / 恢复失败" ;;
                    *) "$SELF" restore || warn "Restore failed / 恢复失败" ;;
                esac
                ;;
            6) ;;
            7) "$SELF" diagnose || warn "Diagnosis failed / 诊断失败" ;;
            0) return 0 ;;
            *) warn "Unknown choice / 未知选项" ;;
        esac
    done
}

command="${1:-menu}"
case "$command" in
    menu) interactive_menu ;;
    help|-h|--help) usage ;;
    status) [ "$#" -eq 1 ] || die "status takes no arguments. / status 不接受参数。"; command_status ;;
    diagnose) [ "$#" -eq 1 ] || die "diagnose takes no arguments. / diagnose 不接受参数。"; command_diagnose ;;
    set) [ "$#" -eq 2 ] || die "Usage: enableMacSiriAI set CODE"; require_root "$@"; command_set "$2" ;;
    unlock) [ "$#" -eq 1 ] || die "unlock takes no arguments. / unlock 不接受参数。"; require_root "$@"; command_unlock ;;
    restore)
        [ "$#" -le 2 ] || die "Usage: enableMacSiriAI restore [--delete-backup]"
        delete_backup=0
        if [ "$#" -eq 2 ]; then
            [ "$2" = "--delete-backup" ] || die "Unknown restore option: $2 / 未知的恢复选项。"
            delete_backup=1
        fi
        require_root "$@"
        command_restore "$delete_backup"
        ;;
    version|--version) printf '%s %s\n' "$PROGRAM" "$VERSION" ;;
    *) error "Unknown command: $command / 未知命令。"; usage >&2; exit 2 ;;
esac
